{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VeritasBench paper case",
  "type": "object",
  "required": ["case_id", "paper_title", "paper_authors", "artifacts", "observations", "claims", "metadata"],
  "additionalProperties": false,
  "properties": {
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "paper_title": {"type": "string", "minLength": 1},
    "paper_authors": {"type": "array", "items": {"type": "string"}},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "kind": {"type": "string"}
        }
      }
    },
    "observations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["value", "source_artifact", "source_artifact_hash", "source_span"],
        "additionalProperties": false,
        "properties": {
          "value": {},
          "source_artifact": {"type": "string", "minLength": 1},
          "source_artifact_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "source_span": {"type": "string", "minLength": 1},
          "source_snippet": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["annotation_id", "claim_id", "claim_atom", "source_artifact", "target_artifact", "relation_type", "verdict", "is_clean_claim", "annotator_id", "annotation_timestamp"],
        "additionalProperties": false,
        "properties": {
          "annotation_id": {"type": "string", "minLength": 1},
          "claim_id": {"type": "string", "minLength": 1},
          "claim_atom": {"type": "string", "minLength": 1},
          "source_artifact": {"type": "string", "minLength": 1},
          "target_artifact": {"type": "string", "minLength": 1},
          "relation_type": {"enum": ["L1", "L2", "L3", "L4"]},
          "verdict": {"enum": ["consistent", "inconsistent", "insufficient"]},
          "discrepancy_type": {"type": ["string", "null"]},
          "evidence_span": {"type": ["string", "null"]},
          "severity": {"enum": ["low", "medium", "high", "critical", null]},
          "annotator_id": {"type": "string"},
          "annotation_timestamp": {"type": "string"},
          "is_clean_claim": {"type": "boolean"}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
