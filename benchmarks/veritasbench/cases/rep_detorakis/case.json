  "claims": [
    {
      "annotation_id": "rep_detorakis_ann_001",
      "claim_id": "rep_detorakis_claim_001",
      "claim_atom": "The reproduced MNN model reproduces the tonic-vs-phasic distinction: under a constant stimulus the tonic-spiking regime keeps firing to the end of the stimulus, whereas the phasic-spiking regime ceases firing well before the stimulus ends.",
      "source_artifact": "artifacts/reproduce_output.json#tonic_spiking_last_spike_step",
      "target_artifact": "artifacts/reproduce_output.json#phasic_spiking_last_spike_step",
      "relation_type": "L1",
      "verdict": "consistent",
      "discrepancy_type": null,
      "evidence_span": "L1:code_output->code_output",
      "severity": "low",
      "annotator_id": "wuguandu",
      "annotation_timestamp": "2026-07-15T00:00:00Z",
      "is_clean_claim": true,
      "_reproduction": "tonic: 最后一次 spike 在第1979步/共2000步(几乎放电到底=强直); phasic: 最后一次 spike 在第1760步/共5000步(35%处即停, 尽管输入恒定=相位). 复现出 tonic vs phasic 定性区别=一致.",
      "_note": "grounding: 须对齐正确的行为(tonic vs phasic)与正确字段(last_spike_step 相对 sim_steps), 不能只看 spike 数(phasic 5 但步长更长易误读)."
    },
    {
